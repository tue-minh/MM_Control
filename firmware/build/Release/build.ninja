#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\MM_Control\firmware\build\Release && "C:\Program Files\CMake\bin\cmake-gui.exe" -SD:\MM_Control\firmware -BD:\MM_Control\firmware\build\Release"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\MM_Control\firmware\build\Release && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SD:\MM_Control\firmware -BD:\MM_Control\firmware\build\Release"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

